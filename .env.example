# Copy this file to backend/.env and fill in your values.
# The backend reads from backend/.env (pydantic-settings resolves relative to cwd,
# so run uvicorn from the backend/ directory).

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default model
# ANTHROPIC_MODEL=claude-opus-4-5
# ANTHROPIC_MAX_TOKENS=4096

# ── Duffel ────────────────────────────────────────────────────────────────────
# Test keys start with "duffel_test_" and hit the sandbox automatically.
# Get yours at: https://app.duffel.com/
DUFFEL_API_KEY=duffel_test_...

# ── Geoapify ──────────────────────────────────────────────────────────────────
# Get your free key at: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=...

# ── Auth (single-user, no database) ───────────────────────────────────────────
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
# The only login the app accepts. Set both in any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ── Deployment ────────────────────────────────────────────────────────────────
# PROD (default) locks /docs behind auth. Set to DEV to open API docs.
# DEPLOYMENT_TYPE=PROD
# Directory containing the built frontend; the API serves the SPA from here when
# it exists. The Docker build sets STATIC_DIR=/app/static automatically.
# STATIC_DIR=static
# Comma-separated CORS origins for split frontend/backend dev (unused in prod).
# CORS_ORIGINS=http://localhost:5173

# ── API server (optional overrides) ───────────────────────────────────────────
# Koyeb injects $PORT at runtime; the container binds to it automatically.
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false
